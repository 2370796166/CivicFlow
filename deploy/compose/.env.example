# LOCAL DEVELOPMENT ONLY. Copy to .env and replace every password before use.
# Never reuse these values outside a loopback-only developer workstation.

# Full-container mode: docker compose up -d --build --wait (from repository root).
# Initial local admin only; existing accounts/passwords are never reset.
CIVICFLOW_LOCAL_ADMIN_USERNAME=admin
CIVICFLOW_LOCAL_ADMIN_PASSWORD=1234
WEB_PORT=5173
GATEWAY_PORT=8080

# Host ports (all Compose bindings are restricted to 127.0.0.1)
MYSQL_PORT=3306
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
NACOS_PORT=8848
NACOS_GRPC_PORT=9848

# MySQL administrator used only by the official image during first initialization
MYSQL_ROOT_PASSWORD=local-root-change-me

# Per-service runtime accounts: DML only
CIVICFLOW_AUTH_DB_APP_USERNAME=civicflow_auth_app
CIVICFLOW_AUTH_DB_APP_PASSWORD=local-auth-app-change-me
CIVICFLOW_RESOURCE_DB_APP_USERNAME=civicflow_resource_app
CIVICFLOW_RESOURCE_DB_APP_PASSWORD=local-resource-app-change-me
CIVICFLOW_APPOINTMENT_DB_APP_USERNAME=civicflow_appointment_app
CIVICFLOW_APPOINTMENT_DB_APP_PASSWORD=local-appointment-app-change-me
CIVICFLOW_QUEUE_DB_APP_USERNAME=civicflow_queue_app
CIVICFLOW_QUEUE_DB_APP_PASSWORD=local-queue-app-change-me

# Per-service Flyway accounts: DDL + DML, restricted to one service schema
CIVICFLOW_AUTH_DB_MIGRATION_USERNAME=civicflow_auth_migration
CIVICFLOW_AUTH_DB_MIGRATION_PASSWORD=local-auth-migration-change-me
CIVICFLOW_RESOURCE_DB_MIGRATION_USERNAME=civicflow_resource_migration
CIVICFLOW_RESOURCE_DB_MIGRATION_PASSWORD=local-resource-migration-change-me
CIVICFLOW_APPOINTMENT_DB_MIGRATION_USERNAME=civicflow_appointment_migration
CIVICFLOW_APPOINTMENT_DB_MIGRATION_PASSWORD=local-appointment-migration-change-me
CIVICFLOW_QUEUE_DB_MIGRATION_USERNAME=civicflow_queue_migration
CIVICFLOW_QUEUE_DB_MIGRATION_PASSWORD=local-queue-migration-change-me

# Redis and RabbitMQ
REDIS_PASSWORD=local-redis-change-me
RABBITMQ_USERNAME=civicflow
RABBITMQ_PASSWORD=local-rabbit-change-me
RABBITMQ_VHOST=civicflow

# Nacos local standalone authentication and environment isolation
NACOS_USERNAME=nacos
NACOS_PASSWORD=local-nacos-change-me
NACOS_NAMESPACE=dev
NACOS_GROUP=CIVICFLOW_GROUP
NACOS_AUTH_IDENTITY_KEY=civicflow-local-server
NACOS_AUTH_IDENTITY_VALUE=local-server-identity-change-me
# Base64 of a local-only secret longer than 32 bytes; generate a new value for your .env.
NACOS_AUTH_TOKEN=Q2l2aWNGbG93TG9jYWxEZXZUb2tlbk9ubHlDaGFuZ2VNZUJlZm9yZVVzZQ==

# Application connection values. Defaults in application-dev.yml match these host ports.
NACOS_SERVER_ADDR=127.0.0.1:8848
REDIS_HOST=127.0.0.1
RABBITMQ_HOST=127.0.0.1
